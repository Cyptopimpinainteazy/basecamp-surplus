# ---- Required ----
DATABASE_URL=                 # Neon Postgres (Vercel Marketplace → Neon); use the pooled connection string
SESSION_SECRET=               # 32+ random characters: openssl rand -base64 48
ADMIN_PASSWORD=               # password for /admin
NEXT_PUBLIC_SITE_URL=https://basecampsurplus.com
BLOB_READ_WRITE_TOKEN=        # added automatically when you create a Vercel Blob store
ANTHROPIC_API_KEY=            # photo-to-listing AI and the support chat

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=        # webhook to https://basecampsurplus.com/api/stripe/webhook, events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_AUTOMATIC_TAX=false    # set true after enabling Stripe Tax and registering in Colorado

# ---- Shipping labels (Shippo) ----
SHIPPO_API_TOKEN=
SHIP_FROM_NAME=Basecamp Surplus
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=Denver
SHIP_FROM_STATE=CO
SHIP_FROM_ZIP=
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
LABEL_FORMAT=PDF_4x6          # or PDF for 8.5x11 paper

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Basecamp Surplus <orders@basecampsurplus.com>
SUPPORT_EMAIL=support@basecampsurplus.com
OWNER_EMAIL=                  # where new-order and support-ticket alerts go

# ---- eBay ----
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=                 # RuName; set its accepted URL to https://basecampsurplus.com/api/ebay/callback
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_PRICE_MARKUP=0.13        # eBay price = site price + 13% to cover fees
# EBAY_ENV=sandbox            # uncomment to test against the eBay sandbox

# ---- Cron ----
CRON_SECRET=                  # random string; Vercel Cron sends it to /api/cron/ebay-orders

# ---- Domains ----
POLES_DOMAIN=replacementtentpole.com
NEXT_PUBLIC_POLES_NAME=Replacement Tent Pole
REDIRECT_DOMAINS=highcountrysurplus.com

# ---- Optional tuning ----
# NEXT_PUBLIC_SITE_NAME=Basecamp Surplus
# FREE_SHIPPING_THRESHOLD_CENTS=15000
# PRICE_NEW_FACTOR=0.62               # NWT price = MSRP × this, before eBay comp check
# PRICE_USED_GOOD_FACTOR=0.42
# PRICE_COMP_UNDERCUT=0.93            # price 7% under the eBay median
# POSHMARK_MARKUP=0.2  MERCARI_MARKUP=0.13  DEPOP_MARKUP=0.12  GEARTRADE_MARKUP=0.15
# ANTHROPIC_LISTING_MODEL=claude-sonnet-5-5
# ANTHROPIC_SUPPORT_MODEL=claude-haiku-5-5
